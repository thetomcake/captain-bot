# Captain Stats Configuration Template
# Copy this file to .env and fill in your values

# Team Configuration
TEAM_NAME=Your Team Name
CLUB_URL=https://manvfatfootball.org/club/your-club/

# WhatsApp Configuration
# Find your group ID by checking the JID in WhatsApp Web
AUTHORIZED_GROUP_ID=1234567890-1234567890@g.us

# MAN v FAT Credentials
# The club fixtures page is gated behind a WordPress login. These credentials are
# seeded onto the team at `init` (username plaintext, password encrypted at rest).
MANVFAT_USERNAME=you@example.com
MANVFAT_PASSWORD=your-portal-password
# 32-byte AES-256-GCM key, base64-encoded, used to encrypt the stored password and
# session cookie. Generate one with: openssl rand -base64 32
# Required for any scrape; a missing or wrong-length key fails fast with a config error.
MANVFAT_CREDENTIAL_KEY=

# Database Configuration
DATABASE_PATH=./captain-stats.db

# Scheduling Configuration (cron format)
# Default: Daily at 6 AM UK time
FIXTURE_CHECK_CRON=0 6 * * *

# Timezone (for UK fixtures)
TIMEZONE=Europe/London

# Logging
LOG_LEVEL=info

# Scraping Configuration
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; CaptainBot/1.0)
SCRAPER_TIMEOUT_MS=10000
SCRAPER_MAX_RETRIES=3

# WhatsApp Rate Limiting
# Conservative defaults to avoid bans
WHATSAPP_MESSAGE_DELAY_MS=12000
WHATSAPP_MAX_MESSAGES_PER_MINUTE=5

# Stat Capture Configuration
STAT_CONFIDENCE_THRESHOLD=70
STAT_CAPTURE_WINDOW_DAYS=3
