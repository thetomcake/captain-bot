{
  "name": "captain-stats",
  "version": "0.1.0",
  "description": "MAN v FAT Football Captain Stats Tool - CLI for fixture tracking, WhatsApp polls, and player stats",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "captain-stats": "./dist/cli/index.js"
  },
  "imports": {
    "#src/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "manvfat",
    "football",
    "stats",
    "whatsapp",
    "cli"
  ],
  "author": "Tom Lindley <tom.lindley@onsecurity.co>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "axios": "^1.17.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "minimist": "^1.2.8",
    "p-queue": "^9.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
